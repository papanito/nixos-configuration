# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  fileSystems = {
    "/" = {
      device = "/dev/disk/by-uuid/0a81878c-2e28-4c73-8589-96446e93c6a4";
      fsType = "ext4";
    };
    "/home" = {
      device = "/dev/disk/by-uuid/a308663e-a262-448d-bfdf-16cd450cf246";
      fsType = "btrfs";
      # --- Fix: BTRFS resilience against NVMe I/O failures ---
      # The NVMe controller crashes (CSTS=0xffffffff) produce errno=-5 I/O
      # errors that BTRFS treats as persistent media failures, forcing the
      # filesystem read-only to protect data. These options reduce the
      # surface area for that outcome:
      #
      # degraded:  allow mounting with missing devices (single-device BTRFS
      #             shouldn't need this, but it avoids abort-on-first-error
      #             behavior when the controller briefly disappears)
      # commit=60: longer commit interval reduces the frequency of sync
      #             writes that can collide with a transient controller lockup
      #             (default is 30s)
      # space_cache=v2: already in mount opts from NixOS default; keep it
      options = [ "degraded" "commit=60" "ssd" "space_cache=v2" ];
    };
    "/boot" = {
      device = "/dev/disk/by-uuid/B581-AD78";
      fsType = "vfat";
    };
  };

  swapDevices = [
    {
      device = "/dev/disk/by-uuid/0b1951d8-e365-4f7a-a072-10c383407677";
    }
  ];

  boot = {
    # Keep more rollback generations than the repo default (5): a bad
    # kernel/desktop update should always leave a bootable fallback.
    loader.systemd-boot.configurationLimit = 12;
    extraModulePackages = [ config.boot.kernelPackages.evdi ];
    #kernelPackages = pkgs.linuxPackages_6_12;
    kernelPackages = pkgs.linuxPackages_latest.extend (
      lfinal: lprev: {
        #        opensnitch-ebpf = lprev.opensnitch-ebpf.overrideAttrs (
        #          old:
        #          # Fixed in 1.7.3: https://github.com/evilsocket/opensnitch/pull/1554
        #          assert lib.versionOlder old.version "1.7.3";
        #          {
        #            preBuild = old.preBuild or "" + ''
        #              makeFlagsArray+=(EXTRA_FLAGS="-Wno-microsoft-anon-tag -fms-extensions")
        #            '';
        #          }
        #        );
      }
    );
    initrd = {
      # The set of kernel modules in the initial ramdisk used during the boot process.
      availableKernelModules = [
        "xhci_pci"
        "thunderbolt"
        "nvme"
        "usb_storage"
        "usbhid"
        "sd_mod"
      ];
      # List of modules that are always loaded by the initrd.
      kernelModules = [
        #"evdi"
      ];
      secrets = {
        "/crypto_keyfile.bin" = null;
      };
      luks.devices = {
        # Enable swap on luks
        "luks-7f34b0ef-aa8a-412a-933c-a42414371fad".device =
          "/dev/disk/by-uuid/7f34b0ef-aa8a-412a-933c-a42414371fad";
        "luks-7f34b0ef-aa8a-412a-933c-a42414371fad".keyFile = "/crypto_keyfile.bin";
        "luks-266811b8-953c-4007-9bbd-ed9a009f72ed".device =
          "/dev/disk/by-uuid/266811b8-953c-4007-9bbd-ed9a009f72ed";
        "luks-361b9e74-4d96-49fa-9243-1676586caed0".device =
          "/dev/disk/by-uuid/361b9e74-4d96-49fa-9243-1676586caed0";
      };
    };

    # Enable binfmt emulation for aarch64
    binfmt.emulatedSystems = [ "aarch64-linux" ];
    runSize = "20%";
    # The set of kernel modules to be loaded in the second stage of the boot process
    kernelModules = [
      "kvm-intel"
      "ifb"
    ];
    loader = {
      systemd-boot.enable = true;
      efi.canTouchEfiVariables = true;
    };
    plymouth = {
      enable = true;
      #themePackages = [ nixos-boot ];
      #theme = "load_unload";
    };
    kernel.sysctl = {
      "vm.swappiness" = 10;
    };
    kernelParams = [
      # --- Fix: NVMe controller crashes (CSTS=0xffffffff) on Crucial P3 Plus + Samsung 990 PRO ---
      # Both NVMe SSDs experience random controller lockups where the device
      # becomes completely unresponsive (CSTS=0xffffffff), the kernel reset
      # fails (-19), and the device is disabled. BTRFS on /home then hits
      # errno=-5 IO failures and is forced read-only.
      #
      # Root cause: aggressive NVMe power management (APST + D3cold) combined
      # with firmware bugs in the Crucial P3 Plus (QLC NAND, DRAM-less,
      # known for controller instability under Linux).
      #
      # nvme_core.default_ps_max_latency_us=0 already disables APST (was set
      # before). The additional params below fully disable all remaining NVMe
      # and PCIe link power states that can trigger the lockup.

      # Keep APST disabled (prevents drive from entering low-power NVMe states)
      "nvme_core.default_ps_max_latency_us=0"

      # Disable PCIe Active State Power Management — prevents the PCIe link
      # from entering L1/L2/L3 sub-states from which the NVMe controller
      # fails to wake on some firmwares (Crucial P3 Plus is notorious).
      "pcie_aspm=off"

      # Disable PCIe port power management entirely — prevents the parent
      # port from powering down the downstream NVMe device during runtime PM.
      "pcie_port_pm=off"

      # --- Fix: black screen after screen lock / suspend (Intel i915) ---
      # DC states (DC3-DC6): deep display power-saving C-states. On many Intel
      # iGPUs the display PHY/DDI fails to reinitialize on resume from DC5/DC6,
      # leaving the panel permanently black. enable_dc=0 disables ALL display
      # C-states - the reliable fix for the "screen never comes back" class.
      # Trade-off: slightly higher idle power draw on the display pipeline.
      "i915.enable_dc=0"
      # Panel Self Refresh: another Intel power-saving feature known to cause
      # black screens / flicker on resume. Disable alongside DC states.
      "i915.enable_psr=0"
      # Frame Buffer Compression: less commonly implicated but part of the same
      # power-saving family; disable for maximum resume reliability.
      "i915.enable_fbc=0"
      "mem_sleep_default=deep" # Use S3 deep sleep instead of s2idle (more reliable resume)
    ];
    blacklistedKernelModules = [ "spd5118" ]; # Fix: DDR5 temp sensor fails to resume after suspend (error -6)

    # --- Fix: prevent D3cold on NVMe controllers ---
    # Even with ASPM disabled, the kernel can still put the NVMe device into
    # D3cold (deepest PCIe power state) via runtime PM. Some NVMe firmwares
    # (Crucial P3 Plus P9CR40A) fail to re-initialize from D3cold, causing
    # the same CSTS=0xffffffff controller lockup. This keeps the nvme_core
    # module loaded with APST disabled at modprobe time (belt-and-suspenders
    # alongside the kernelParam).
    extraModprobeConfig = ''
      options nvme_core default_ps_max_latency_us=0
    '';
  };

  # --- Fix: disable runtime PM + D3cold for NVMe controllers ---
  # Both NVMe SSDs (Crucial P3 Plus CT4000P3PSSD8, Samsung 990 PRO) suffer
  # CSTS=0xffffffff controller lockups. The kernelParams above already
  # disable APST/ASPM/port PM globally; this rule additionally pins each
  # NVMe PCI function to full power (no runtime suspend, no D3cold).
  #
  # IMPORTANT: the match MUST be SUBSYSTEM=="pci" + DRIVER=="nvme".
  # An earlier version used KERNEL=="nvme[0-9]*" + SUBSYSTEM=="pci",
  # which never fires: the nvme controller uevent has SUBSYSTEM=nvme,
  # while the PCI uevent has KERNEL="0000:01:00.0".
  # Trade-off: ~1-2W higher idle power draw per NVMe drive.
  services.udev.extraRules = ''
    ACTION=="add", SUBSYSTEM=="pci", DRIVER=="nvme", ATTR{power/control}="on", ATTR{d3cold_allowed}="0"
  '';

  services = {
    hardware.bolt.enable = true;
    upower.enable = true;
    jitterentropy-rngd.enable = true; # Random number generator, which injects entropy to the kernel
  };
  # required for wondershapper
  systemd.network.netdevs.ifb0 = {
    enable = true;
  };
  # host-specific packages
  environment.systemPackages = with pkgs; [
    displaylink # DisplayLink DL-7xxx, DL-6xxx, DL-5xxx, DL-41xx and DL-3x00 Driver for Linux
    # --- NVMe diagnostics: monitor controller health and SMART data ---
    nvme-cli # nvme smart-log, nvme error-log, firmware update
    smartmontools # smartctl — cross-platform SMART monitoring
  ];

  hardware = {
    # Enable hardware graphics acceleration (crucial for Wayland performance)
    graphics.enable = true;

    # For AMD GPUs (uncomment if you have one)
    # hardware.opengl.extraPackages = with pkgs; [ mesa.amdgpu-pro-vulkan-driver ];
    # For Intel GPUs (uncomment if you have one)
    graphics.extraPackages = with pkgs; [ intel-media-driver ];

    bluetooth = {
      enable = true;
      powerOnBoot = true;
    };
  };
  # --- Fix: BTRFS read-only detection + self-heal ---
  # When an NVMe controller wedges (CSTS=0xffffffff) and its reset fails,
  # the kernel disables the device, BTRFS on /home gets errno=-5 I/O errors,
  # aborts the transaction and forces the filesystem read-only. This monitor
  # polls /home writability every 2 minutes. On failure it first attempts a
  # non-destructive recovery (PCI remove + rescan of ONLY the NVMe device
  # backing /home, then a rw remount). If that restores writability it logs
  # a recovery notice; otherwise it raises a critical desktop notification.
  systemd.services.btrfs-readonly-monitor = {
    description = "Detect BTRFS read-only remount, self-heal via PCI rescan, and alert";
    after = [ "home.mount" ];
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "simple";
      ExecStart = pkgs.writeShellScript "btrfs-readonly-monitor" ''
        probe=/home/.readonly-probe
        notify_critical () {
          for uid in $(${pkgs.systemd}/bin/loginctl list-users --no-legend | awk '{print $1}'); do
            user=$(getent passwd "$uid" | cut -d: -f1)
            if [ -n "$user" ] && [ -d "/run/user/$uid" ]; then
              DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                ${pkgs.util-linux}/bin/runuser -u "$user" -- \
                ${pkgs.libnotify}/bin/notify-send -u critical "$@" 2>/dev/null || true
            fi
          done
        }
        while true; do
          if ! touch "$probe" 2>/dev/null; then
            ${pkgs.util-linux}/bin/logger -t btrfs-monitor "/home is read-only — attempting NVMe PCI rescan recovery"
            # Resolve the NVMe PCI function that backs /home (btrfs -> LUKS -> nvmeXn1),
            # remove + rescan it so the kernel re-probes the wedged controller.
            # NEVER touch other NVMe devices: they may host the root filesystem.
            src=$(${pkgs.util-linux}/bin/findmnt -n -o SOURCE /home 2>/dev/null)
            # Mapper names (/dev/mapper/luks-*) don't exist under
            # /sys/class/block; resolve through the real device (dm-N).
            base=$(basename "$(readlink -f "''${src:-}" 2>/dev/null)")
            if [ -n "$base" ] && [ -e "/sys/class/block/$base/slaves" ]; then
              for ns in /sys/class/block/"$base"/slaves/*; do
                # Slave may be a partition (nvme0n1p1); walk up the sysfs
                # path to the nvmeX CONTROLLER. Namespace names (nvme0n1)
                # also match nvme[0-9]*, so require the class dir — only
                # controllers have /sys/class/nvme/<name>.
                d=$(readlink -f "$ns")
                ctrl=""
                while [ "$d" != "/" ] && [ -n "$d" ]; do
                  b=$(basename "$d")
                  case $b in
                    nvme[0-9]*)
                      if [ -e "/sys/class/nvme/$b" ]; then ctrl=$b; break; fi ;;
                  esac
                  d=$(dirname "$d")
                done
                [ -n "$ctrl" ] || continue
                pcidev=$(readlink -f "/sys/class/nvme/$ctrl/device" 2>/dev/null) || continue
                echo 1 > "$pcidev/remove" 2>/dev/null || true
              done
              echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
              sleep 5
            fi
            ${pkgs.util-linux}/bin/mount -o remount,rw /home 2>/dev/null || true
            if touch "$probe" 2>/dev/null; then
              rm -f "$probe"
              ${pkgs.util-linux}/bin/logger -t btrfs-monitor "RECOVERED: /home writable again after PCI rescan — run 'btrfs scrub start -B /home' to verify data."
              notify_critical "Disk Recovered" "/home was read-only; NVMe PCI rescan restored it. Run a btrfs scrub soon."
            else
              ${pkgs.util-linux}/bin/logger -t btrfs-monitor "ALERT: /home still read-only after rescan — reboot required."
              notify_critical "Disk Emergency" "/home is READ-ONLY and recovery failed. Save your work and reboot."
            fi
          else
            rm -f "$probe" 2>/dev/null || true
          fi
          sleep 120
        done
      '';
      Restart = "always";
      RestartSec = 60;
    };
  };
  # --- BTRFS periodic scrub ---
  # /home is single-device btrfs (no redundancy): checksum errors are
  # detectable but NOT repairable without a second copy. A weekly scrub at
  # least surfaces corruption early; restic restores are the repair path.
  services.btrfs.autoScrub = {
    enable = true;
    fileSystems = [ "/home" ];
    interval = "weekly";
  };
  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp0s20f0u1.useDHCP = lib.mkDefault true
  # networking.interfaces.wlo1.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  powerManagement.cpuFreqGovernor = lib.mkDefault "powersave";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
